<?xml version="1.0"?>
<sdf version="1.7">
  <model name="carton_box">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.025</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.030</iyy><iyz>0</iyz><izz>0.020</izz>
        </inertia>
      </inertial>
      <collision name="col">
        <geometry><box><size>0.40 0.30 0.30</size></box></geometry>
        <surface>
          <contact><ode><kp>1e6</kp><kd>1.0</kd></ode></contact>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
        </surface>
      </collision>
      <!-- Main box body -->
      <visual name="box_body">
        <geometry><box><size>0.40 0.30 0.30</size></box></geometry>
        <material>
          <ambient>0.76 0.60 0.33 1</ambient>
          <diffuse>0.76 0.60 0.33 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Top crease lines (dark strips) -->
      <visual name="crease_x">
        <pose>0 0 0.151 0 0 0</pose>
        <geometry><box><size>0.41 0.01 0.001</size></box></geometry>
        <material><ambient>0.4 0.3 0.1 1</ambient></material>
      </visual>
      <visual name="crease_y">
        <pose>0 0 0.151 0 0 0</pose>
        <geometry><box><size>0.01 0.31 0.001</size></box></geometry>
        <material><ambient>0.4 0.3 0.1 1</ambient></material>
      </visual>
      <!-- Tape strip -->
      <visual name="tape">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.41 0.04 0.302</size></box></geometry>
        <material><ambient>0.5 0.7 0.9 0.6</ambient><diffuse>0.5 0.7 0.9 0.6</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
