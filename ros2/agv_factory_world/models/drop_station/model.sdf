<?xml version="1.0"?>
<sdf version="1.7">
  <model name="drop_station">
    <static>true</static>
    <link name="link">
      <!-- Recessed drop bay floor -->
      <collision name="bay_floor"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>1.4 1.0 0.02</size></box></geometry></collision>
      <visual name="bay_floor">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>1.4 1.0 0.02</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>

      <!-- Perimeter safety bumper (orange) — 4 sides -->
      <collision name="bumper_n"><pose>0  0.52 0.035 0 0 0</pose><geometry><box><size>1.44 0.04 0.07</size></box></geometry></collision>
      <visual name="bumper_n"><pose>0  0.52 0.035 0 0 0</pose><geometry><box><size>1.44 0.04 0.07</size></box></geometry><material><ambient>1.0 0.4 0.0 1</ambient></material></visual>
      <collision name="bumper_s"><pose>0 -0.52 0.035 0 0 0</pose><geometry><box><size>1.44 0.04 0.07</size></box></geometry></collision>
      <visual name="bumper_s"><pose>0 -0.52 0.035 0 0 0</pose><geometry><box><size>1.44 0.04 0.07</size></box></geometry><material><ambient>1.0 0.4 0.0 1</ambient></material></visual>
      <collision name="bumper_e"><pose> 0.72 0 0.035 0 0 0</pose><geometry><box><size>0.04 1.04 0.07</size></box></geometry></collision>
      <visual name="bumper_e"><pose> 0.72 0 0.035 0 0 0</pose><geometry><box><size>0.04 1.04 0.07</size></box></geometry><material><ambient>1.0 0.4 0.0 1</ambient></material></visual>
      <!-- West side open for AGV entry -->

      <!-- Zebra striped floor markings -->
      <visual name="stripe_1"><pose>-0.4 0 0.021 0 0 0</pose><geometry><box><size>0.15 1.0 0.001</size></box></geometry><material><ambient>1 1 0 0.7</ambient></material></visual>
      <visual name="stripe_2"><pose> 0.0 0 0.021 0 0 0</pose><geometry><box><size>0.15 1.0 0.001</size></box></geometry><material><ambient>1 1 0 0.7</ambient></material></visual>
      <visual name="stripe_3"><pose> 0.4 0 0.021 0 0 0</pose><geometry><box><size>0.15 1.0 0.001</size></box></geometry><material><ambient>1 1 0 0.7</ambient></material></visual>

      <!-- "DROP" indicator light (red) -->
      <visual name="indicator">
        <pose>0.68 0 0.15 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material><ambient>1.0 0.1 0.1 1</ambient><diffuse>1.0 0.1 0.1 1</diffuse><emissive>0.8 0.0 0.0 1</emissive></material>
      </visual>
    </link>
  </model>
</sdf>
